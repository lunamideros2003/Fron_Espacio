# URL del backend. En desarrollo Vite ya hace proxy de /api, pero sirve
# para apuntar a Render sin tocar código.
VITE_API_URL=http://localhost:4000

# Producción (Vercel):
# VITE_API_URL=https://astroia-api.onrender.com

# Supabase vive detrás del backend. El navegador NO necesita la service key.
# Si más adelante usas Supabase Auth directo desde React, agrega:
# VITE_SUPABASE_URL=https://[project-ref].supabase.co
# VITE_SUPABASE_ANON_KEY=...
